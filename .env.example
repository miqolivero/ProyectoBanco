# Copiar a .env y completar. En desarrollo local, DATABASE_URL apunta al Postgres local
# y FRONTEND_URL puede omitirse (el CORS ya deja pasar cualquier localhost:<puerto>).

# Postgres. En local: postgres://postgres:admin123@localhost:5432/banco_db
# En producción: la cadena de conexión que te da el host de la base (Neon, Supabase, etc.)
DATABASE_URL=postgres://postgres:admin123@localhost:5432/banco_db

# API compartida del Banco Central de la cátedra.
CENTRAL_BANK_API_KEY=

# Claves de Clerk para que el BACKEND pueda verificar de verdad la sesión de cada request (ver
# middlewares/auth.js) en vez de confiar ciegamente en el cbu/idPersona que mande el frontend.
# Sacalas de https://dashboard.clerk.com → tu proyecto → API Keys. Hacen falta LAS DOS — sin
# cualquiera de ellas, todos los endpoints protegidos responden 503.
# Secret Key (empieza con "sk_") — NO es la misma que VITE_CLERK_PUBLISHABLE_KEY del frontend.
CLERK_SECRET_KEY=
# Publishable Key (empieza con "pk_") — es la MISMA que frontend/.env usa como
# VITE_CLERK_PUBLISHABLE_KEY, solo que acá además la necesita el backend.
CLERK_PUBLISHABLE_KEY=

# Asistente bancario con IA (Gemini — https://aistudio.google.com/apikey, tiene tier gratis
# permanente, sin tarjeta). Sin esto /api/asistente/chat responde 503 (ver config/asistenteIA.js).
GEMINI_API_KEY=

PORT=3001

# Dominio del frontend ya desplegado (Vercel, etc.), sin barra final. Se suma a la lista
# de orígenes permitidos por CORS además de cualquier localhost:<puerto> (ver app.js).
# Se pueden separar varios con coma, ej: https://mi-banco.vercel.app,https://otro-dominio.com
FRONTEND_URL=

# Modo demo (portafolio público). El backend YA verifica la sesión de Clerk en todos los
# endpoints que tocan plata (ver middlewares/auth.js), así que nadie puede operar sobre una
# cuenta que no sea la suya. DEMO_MODE es una restricción extra y distinta: Transferencias y
# Préstamos son las dos features que escriben en la red COMPARTIDA del Banco Central de la
# cátedra (visible para todos los grupos), así que con DEMO_MODE=true solo los CBU listados en
# DEMO_CBUS (coma-separados) pueden usarlas — útil si dejás el proyecto público y no querés que
# cualquiera que se registre genere movimientos/deudas en la red de la cátedra.
# Ver config/demoMode.js. En desarrollo local dejar ambas vacías/en false.
DEMO_MODE=false
DEMO_CBUS=
