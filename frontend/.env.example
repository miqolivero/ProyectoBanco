# Copiar a .env y ajustar. En desarrollo local se puede dejar vacío/omitir: el código
# cae solo a http://localhost:3001 (ver src/config/api.js).

# URL del backend ya desplegado (Render, Railway, etc.). Sin barra final.
VITE_API_URL=http://localhost:3001

# Clave pública de Clerk (la misma que ya usa el proyecto en desarrollo).
VITE_CLERK_PUBLISHABLE_KEY=
