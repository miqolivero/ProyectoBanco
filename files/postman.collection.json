{
  "info": {
    "name": "Calamuchita Bank - API local",
    "description": "API REST propia de Calamuchita Bank (no la del Banco Central de la catedra).\n\nANTES DE EMPEZAR: casi todos los endpoints exigen un JWT de sesion de Clerk. Para\nconseguirlo hay que entrar al frontend (http://localhost:5173), iniciar sesion, abrir\nlas DevTools del navegador y copiar el token de cualquier request a /api/ (header\nAuthorization: Bearer ...). Pegarlo en la variable `token` de la coleccion.\n\nLos requests marcados \"No Auth\" son los que no exponen datos de nadie: health, las\ncotizaciones y los catalogos.\n\nDocumentacion completa de cada endpoint: docs/API.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "description": "En produccion: https://<tu-app>.onrender.com"
    },
    {
      "key": "token",
      "value": "",
      "description": "JWT de sesion de Clerk (ver la descripcion de la coleccion)"
    },
    {
      "key": "clerkId",
      "value": "",
      "description": "ID del usuario en Clerk, ej: user_2abc..."
    },
    {
      "key": "idPersona",
      "value": "1",
      "description": "Tiene que ser la persona del token, si no responde 403"
    },
    {
      "key": "cbu",
      "value": "",
      "description": "CBU propio. Los datos de ejemplo cargan varios (ver docs/BASE-DE-DATOS.md)"
    },
    {
      "key": "cbuDestino",
      "value": "",
      "description": "CBU o alias de destino, puede ser de otro banco de la red"
    }
  ],
  "item": [
    {
      "name": "00. Health check",
      "description": "Lo primero que conviene correr: confirma que el server levanto y que llega a la base.",
      "item": [
        {
          "name": "Estado del servicio y de la base",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "01. Personas y cuentas",
      "description": "Alta de usuario y datos del titular. El POST y los dos /clerk no pasan por requireAuth (la fila local todavia no existe) pero exigen que el clerkId sea el de la sesion.",
      "item": [
        {
          "name": "Crear persona (onboarding) - exige sesion de Clerk",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/personas",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laura\",\n  \"apellido\": \"Martinez\",\n  \"dni\": \"41000000\",\n  \"email\": \"laura.m@email.com\",\n  \"telefono\": \"3546445566\",\n  \"fecha_nacimiento\": \"1998-03-22\",\n  \"direccion\": \"Belgrano 120, Villa General Belgrano\",\n  \"alias\": \"laura.martinez.aho\",\n  \"clerkId\": \"{{clerkId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verificar si el usuario ya hizo el onboarding",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/personas/verificar/{{clerkId}}"
          }
        },
        {
          "name": "Buscar persona por clerkId (solo el propio)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/personas/clerk/{{clerkId}}"
          }
        },
        {
          "name": "Listar todas las personas - SOLO GERENCIA (403 para clientes)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/personas"
          }
        },
        {
          "name": "Roles de una persona",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/personas/{{idPersona}}/roles"
          }
        },
        {
          "name": "Productos de una persona",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/personas/{{idPersona}}/productos"
          }
        },
        {
          "name": "Ver caja de ahorro en USD",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/personas/{{idPersona}}/cuenta-usd"
          }
        },
        {
          "name": "Abrir caja de ahorro en USD",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/personas/{{idPersona}}/cuenta-usd"
          }
        },
        {
          "name": "Cambiar el alias de la cuenta",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/personas/{{cbu}}/alias",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevoAlias\": \"laura.ahorro.usd\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Actualizar datos de contacto",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/personas/{{idPersona}}/perfil",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"laura.nueva@email.com\",\n  \"telefono\": \"3546447788\",\n  \"direccion\": \"Sarmiento 45, Santa Rosa de Calamuchita\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "02. Movimientos",
      "description": "Transferencias (propias y a otros bancos de la red del Banco Central), depositos, recargas y cambio de divisa.",
      "item": [
        {
          "name": "Historial de la cuenta",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/movimientos/historial?cbu={{cbu}}"
          }
