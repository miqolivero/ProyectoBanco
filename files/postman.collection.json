            "method": "GET",
            "url": "{{baseUrl}}/api/movimientos/validar-destino/{{cbuDestino}}"
          }
        },
        {
          "name": "Transferir (acepta CBU o alias en cbu_destino)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/movimientos/transferir",
            "header": [
              {
                "key": "Content-Type",
